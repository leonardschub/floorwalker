{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floorwalker",
  "version": "0.1.0",
  "identifier": "io.github.leonardschub.floorwalker",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter web dev:desktop",
    "beforeBuildCommand": "pnpm --filter web build:desktop",
    "runner": "../world-assets/cargo-runner.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Floorwalker",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 480,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "category": "Productivity",
    "resources": {
      "../world-assets/out/": "world-assets/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
