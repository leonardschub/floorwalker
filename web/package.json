{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/validate-legal.mjs && vite",
    "dev:desktop": "node scripts/validate-legal.mjs && vite --mode desktop",
    "build": "node scripts/validate-legal.mjs && tsc -b && vite build",
    "build:desktop": "node scripts/validate-legal.mjs && tsc -b && vite build --mode desktop",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "legal:licenses": "node scripts/generate-oss-licenses.mjs",
    "legal:check": "node scripts/validate-legal.mjs && node scripts/generate-oss-licenses.mjs --check",
    "test": "node scripts/validate-legal.mjs && vitest run"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@floorwalker/i18n": "workspace:*",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pages": "^0.33.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-parse": "^11.0.0",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
